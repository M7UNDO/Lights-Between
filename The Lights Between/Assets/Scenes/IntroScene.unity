  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroDialogueController
  skipAction: {fileID: -1368742839032262552, guid: 735f955fc1960034e8e2c6885fc40fd7, type: 3}
  skipPromptObject: {fileID: 252807870}
  dateText: {fileID: 413639407}
  locationText: {fileID: 207969690}
  dialogueText: {fileID: 331412173}
  ellipsisText: {fileID: 469479249}
  dateLine: '11 August 2004

    11:13 AM'
  locationLine: Morrow Family Home
  playerThoughts:
  - I tried calling before I left campus. Still nothing. Mom always says the phones
    out here are unreliable, but she never goes this long without checking in.
  - Nothing from Dad. Nothing from Samuel. No messages, no letters. Two weeks without
    hearing anything from them, something is wrong
  - I told myself I was overthinking it the whole drive here. Dad would probably
    laugh and say I've gone soft
  - Still, I needed to come home and see them for myself.
  typeSpeed: 0.03
  dateHoldTime: 5
  locationHoldTime: 3
  fadeDuration: 1
  ellipsisFlashSpeed: 0.5
  levelLoader: {fileID: 4802153305420895504}
  levelSceneIndex: 2
  dateCanvasGroup: {fileID: 413639409}
  locationCanvasGroup: {fileID: 207969692}
  dialogueCanvasGroup: {fileID: 382626848}
